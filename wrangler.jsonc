{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "baisenousroman-tv",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-21",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "baisenousroman.tv", "custom_domain": true },
    { "pattern": "stats.baisenousroman.tv", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/"]
  }
}
